[mysqld]
# ==============================================================
# Flink CDC 的前置条件（见文档 12 节坑 #2）
# 缺任何一项，CDC 作业启动就会失败或读不到增量。
# ==============================================================

# server-id 必须唯一。注意这是 MySQL 实例的 id，
# 与 Flink CDC connector 的 'server-id' 选项是两回事：
# 后者是 Flink 伪装成 slave 时用的 id，必须与本值以及其他 source 都不冲突。
server-id = 1

# 开启 binlog 并使用 ROW 格式。MySQL 8.0 默认已经是 ROW，这里显式声明防止被环境覆盖。
log-bin = mysql-bin
binlog_format = ROW

# 必须是 FULL：CDC 需要完整的 before 镜像才能产出 -U 旧值。
# 设成 MINIMAL 会导致 UPDATE 事件只有变更字段，
# 下游拿不到修正前的报工量，"不重复累加"的逻辑就断了（见文档 6.1.1）。
binlog_row_image = FULL

# binlog 保留 7 天。太短的话作业停机久了 offset 失效，只能重新全量。
binlog_expire_logs_seconds = 604800

# 时区：与业务时区一致，避免 DATETIME 读出来偏移（见文档 12 节坑 #5）
default-time-zone = '+08:00'

# 造数阶段会有较多并发写入连接
max_connections = 500

# 10 个库的表数量不少，放宽表缓存
table_open_cache = 4000

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

[client]
default-character-set = utf8mb4
